{
  "name": "sozvon",
  "productName": "Sozvon",
  "version": "2.2.2",
  "description": "Созвон — голосовые звонки и чат с друзьями",
  "author": "IlyaDasler",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "node scripts/make-icon.js",
    "dist": "node scripts/make-icon.js && electron-builder --win --x64 --publish never && node scripts/check-package.js",
    "test": "node --test test/*.test.js"
  },
  "build": {
    "appId": "ru.ilyadasler.sozvon",
    "productName": "Sozvon",
    "copyright": "© IlyaDasler",
    "npmRebuild": false,
    "files": [
      "*.js",
      "renderer/**/*",
      "assets/**/*"
    ],
    "publish": {
      "provider": "github",
      "owner": "IlyaDasler",
      "repo": "sozvon"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "shortcutName": "Созвон",
      "uninstallDisplayName": "Созвон",
      "artifactName": "Sozvon-Setup-${version}.${ext}",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049"
    }
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.5"
  }
}
