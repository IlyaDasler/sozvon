{
  "name": "sozvon",
  "productName": "Sozvon",
  "version": "3.5.3",
  "description": "Созвон — голосовые звонки и чат с друзьями",
  "author": "IlyaDasler",
  "license": "MIT",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "icon": "electron scripts/make-icon.js",
    "native": "cd native/capture && npm ci --ignore-scripts && npx node-gyp rebuild",
    "dist": "electron-builder --win --x64 --publish never && node scripts/check-package.js",
    "dist:mac": "electron-builder --mac --publish never && node scripts/check-package-mac.js",
    "test": "node --test test/*.test.js",
    "lint": "biome check renderer/update-bar.mjs scripts/run-e2e.js scripts/e2e-mac-update.js test/update-bar.test.js",
    "format": "biome format --write renderer/update-bar.mjs scripts/run-e2e.js scripts/e2e-mac-update.js test/update-bar.test.js"
  },
  "build": {
    "appId": "ru.ilyadasler.sozvon",
    "productName": "Sozvon",
    "copyright": "© IlyaDasler",
    "npmRebuild": false,
    "afterPack": "scripts/after-pack.js",
    "files": [
      "*.js",
      "renderer/**/*",
      "assets/**/*",
      "native/capture/index.js",
      "native/capture/build/Release/sozvon_capture.node"
    ],
    "asarUnpack": [
      "native/capture/build/Release/*.node"
    ],
    "publish": {
      "provider": "github",
      "owner": "IlyaDasler",
      "repo": "sozvon"
    },
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "category": "public.app-category.social-networking",
      "icon": "build/icon.png",
      "artifactName": "Sozvon-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Созвон использует микрофон, чтобы вы могли говорить.",
        "NSCameraUsageDescription": "Созвон использует камеру для видеозвонков.",
        "NSScreenCaptureUsageDescription": "Созвон показывает ваш экран друзьям, когда вы включаете трансляцию.",
        "NSAudioCaptureUsageDescription": "Созвон передаёт звук с вашего экрана, чтобы друзья слышали видео и музыку при трансляции."
      },
      "hardenedRuntime": false,
      "gatekeeperAssess": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "include": "build/installer.nsh",
      "shortcutName": "Созвон",
      "uninstallDisplayName": "Созвон",
      "artifactName": "Sozvon-Setup-${version}.${ext}",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@capacitor/cli": "^8.6.0",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/push-notifications": "^8.1.3",
    "electron-updater": "^6.8.11",
    "uiohook-napi": "^1.5.5"
  }
}
