# Публичный IP-адрес вашего VPS
PUBLIC_IP=203.0.113.10

# Любая длинная случайная строка (например, вывод команды: openssl rand -hex 32)
TURN_SECRET=замените-на-случайную-строку

# Код приглашения: без него зарегистрироваться нельзя (оставьте пустым, чтобы пускать всех)
INVITE_CODE=

# Вход через Google / Яндекс / VK — как получить ключи, см. README
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
VK_CLIENT_ID=

# Домен для HTTPS (нужен только для профиля https), например sozvon.example.ru
DOMAIN=
